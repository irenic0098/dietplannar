# Django Configuration
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*

# PostgreSQL Database Configuration (e.g. Supabase, Render Postgres)
# Example Supabase direct connection string:
# DATABASE_URL=postgresql://postgres:[password]@db.[supabase-project].supabase.co:5432/postgres
# Example Supabase pooled connection string (Port 6543):
# DATABASE_URL=postgresql://postgres:[password]@db.[supabase-project].supabase.co:6543/postgres?pgbouncer=true
DATABASE_URL=

# Set to False if your local database does not support/require SSL
DATABASE_SSL=True

# CORS Settings
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-app.render.com
